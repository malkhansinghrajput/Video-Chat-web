# ─────────────────────────────────────────────
# Environment Configuration
# Copy to .env and fill in real values.
# NEVER commit the real .env to source control.
# ─────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
SERVICE_NAME=api
LOG_LEVEL=debug

# Security
# CHANGE IN PRODUCTION: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Minimum 32 characters required. Known dev placeholders are rejected in production.
SESSION_HMAC_SECRET=change-me-in-development-minimum-32-chars!!
NONCE_TTL_SECONDS=60

# CORS - comma-separated origins (NO wildcards in production when credentials are used)
# Production example: CORS_ORIGIN=https://yourapp.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/videochat_dev
MONGODB_DB_NAME=videochat_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DISABLED=false
REDIS_ERROR_LOG_INTERVAL_MS=60000

# TURN / Coturn
# Development: use localhost TURN (skipped automatically in ICE config)
# Production: set to your actual TURN server, e.g.: turn:turn.yourserver.com:3478
TURN_SERVER_URLS=turn:localhost:3478
# CHANGE IN PRODUCTION: minimum 20 characters, no known dev placeholder values
TURN_SERVER_SECRET=change-me-turn-shared-secret
TURN_CREDENTIAL_TTL_SECONDS=3600

# Admin API Token
# CHANGE IN PRODUCTION: generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 20 characters. The value 'development-admin-token' is rejected in production.
ADMIN_API_TOKEN=development-admin-token

# Rate Limits
RATE_LIMIT_SESSION_INIT_MAX=3
RATE_LIMIT_SESSION_INIT_WINDOW_HOURS=1
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_NEXT_MAX=10
RATE_LIMIT_NEXT_WINDOW_SECONDS=60
RATE_LIMIT_MSG_MAX=10
RATE_LIMIT_MSG_WINDOW_SECONDS=10
RATE_LIMIT_REPORT_MAX=5
RATE_LIMIT_REPORT_WINDOW_HOURS=24

# Matching Engine
MATCH_POLL_INTERVAL_MS=50
MATCH_COUNTRY_RELAXATION_SECONDS=5
MATCH_LANGUAGE_RELAXATION_SECONDS=10
MATCH_INTEREST_RELAXATION_SECONDS=15
MATCH_GLOBAL_FALLBACK_SECONDS=30
QUEUE_ENTRY_TTL_SECONDS=60
QUEUE_CLEANUP_INTERVAL_MS=5000
QUEUE_CLEANUP_BATCH_SIZE=100
MATCH_CANDIDATE_BATCH_SIZE=1000

# Moderation
AUTO_BAN_REPORT_THRESHOLD=10
AUTO_BAN_WINDOW_MINUTES=60
AUTO_BAN_DURATION_HOURS=24

# Session
SESSION_TTL_SECONDS=86400
HEARTBEAT_INTERVAL_MS=25000
HEARTBEAT_TIMEOUT_MS=5000
RECONNECT_GRACE_PERIOD_MS=5000

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9101