# Copy to .env.test. This file is deliberately ignored by git.
# It must point only to isolated staging services. Never use production values.
NODE_ENV=test
VALIDATION_ENVIRONMENT=staging
PORT=3002
SERVICE_NAME=videochat-validation
LOG_LEVEL=info
SESSION_HMAC_SECRET=<TEST_ONLY_SECRET_AT_LEAST_32_CHARACTERS>
ADMIN_API_TOKEN=<TEST_ONLY_ADMIN_TOKEN>
NONCE_TTL_SECONDS=60
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# The validation script accepts these STAGING_ aliases only in NODE_ENV=test.
STAGING_MONGODB_URI=<STAGING_MONGODB_URI>
STAGING_MONGODB_DB_NAME=videochat_loadtest
STAGING_REDIS_HOST=<STAGING_REDIS_HOST>
STAGING_REDIS_PORT=6379
STAGING_REDIS_USERNAME=default
STAGING_REDIS_PASSWORD=<STAGING_REDIS_PASSWORD>
STAGING_REDIS_TLS=true
# Or use STAGING_REDIS_URL=<STAGING_REDIS_URL> if the provider supplies a URL.

# TURN/signaling configuration to verify against the staging backend.
TURN_SERVER_URLS=<STAGING_TURN_URLS>
TURN_SERVER_SECRET=<STAGING_TURN_SHARED_SECRET>
TURN_CREDENTIAL_TTL_SECONDS=3600

# Keep staging test data short lived and use an isolated port.
SESSION_TTL_SECONDS=3600
QUEUE_ENTRY_TTL_SECONDS=60
HEARTBEAT_INTERVAL_MS=25000
HEARTBEAT_TIMEOUT_MS=5000
RECONNECT_GRACE_PERIOD_MS=5000
METRICS_ENABLED=true
METRICS_PORT=9102
