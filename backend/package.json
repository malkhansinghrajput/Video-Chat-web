{
  "name": "backend",
  "version": "1.0.0",
  "description": "Production-grade random video chat platform backend",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "validate:staging": "set NODE_ENV=test&& set ENV_FILE=.env.test&& ts-node scripts/validate-staging.ts",
    "validate:staging:writes": "set NODE_ENV=test&& set ENV_FILE=.env.test&& set VALIDATION_ALLOW_DESTRUCTIVE=true&& ts-node scripts/validate-staging.ts --write"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "mongoose": "^8.7.0",
    "prom-client": "^15.1.0",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.0",
    "uuid": "^11.1.1",
    "winston": "^3.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
