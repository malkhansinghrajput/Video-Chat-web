# ─────────────────────────────────────────────
# Frontend Environment Configuration Example
# ─────────────────────────────────────────────
#
# DEVELOPMENT: Copy to .env in the frontend directory.
# PRODUCTION: Set these as environment variables in your hosting
#             platform (Vercel, Netlify, etc.) — do NOT commit
#             production values to the repository.
#
# WARNING: The localhost URLs below are for local development ONLY.
#          They must be overridden in production or the build will
#          point to localhost and fail for all real users.
# ─────────────────────────────────────────────

# Backend Server URL (used by Socket.IO client connection)
# Production example: https://api.videochatweb.com
VITE_BACKEND_URL=http://localhost:3001

# REST API Base URL (used by api.ts for session/ICE endpoints)
# Production example: https://api.videochatweb.com/api/v1
# NOTE: If left unset, api.ts falls back to '/api/v1' (relative, same-origin) — correct for prod.
VITE_API_URL=http://localhost:3001/api/v1
